# Copiar a .env y ajustar. No subir .env al repositorio.
QDRANT_API_KEY=qdrant-lab-clave-local-cambiar
QDRANT_URL=http://qdrant:6333
QDRANT_URL_PUBLICA=http://localhost:6333
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
FASTEMBED_CACHE_PATH=/models
MUESTRA_PATH=/app/data/muestra_bitext.parquet
BENCHMARK_PATH=/app/data/benchmark_grabado.csv
PRICING_PATH=/app/pricing.yaml
# Contenedor (docker compose --profile llm). Para Ollama nativo en el host:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
# En la Mac M4 Max se puede usar qwen2.5:14b
OLLAMA_MODEL=llama3.2:3b
CACHE_THRESHOLD=0.92
